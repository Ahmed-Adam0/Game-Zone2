@model IEnumerable<Game>

@{
    ViewData["Title"] = "Home Page";
}
@if(!Model.Any())
{
    <div class="alert  alert-warning mt-5">
        <h4 class="alert-heading">NO Games!</h4>
        <p class="mb-0">No Games Added Yet.</p>
    </div>
}
else
{
    <div class="row mt-5">
        @foreach (var game in Model)
        {   
            <div class="col-lg-4 col-md-6">
                <a class="card border-success mb-3 text-decoration-none rounded-3 overflow-hidden" asp-controller="Games" asp-action="Details" asp-route-id="@game.ID">
                    <div class="card-header">Header</div>
                    <div class="card-body" style="background-image:url(@($"{Filesittings.ImagePath}{game.Cover}"));background-size:cover;background-position:center;height:500px; ">
                            
                     </div>
                     <div class="card-footer text-muted d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-end h-100">
                            <span class="badge  text-success rounded-3 fs-3">@game.category?.Name</span>
                        </div>
                         <span class="text-success rounded-2 fs-3">@game.Name </span>
                         <div> 
                             @foreach(var gameDevices in game.Devices)
                            {
                                <i class="@gameDevices.Device.Icon me-2 fs-4"></i>
                            }
                        </div>
                     </div>
                 </a>
            </div>
        }
    </div>
}   